ScriptNode {"Script":{"value":"input Player player;\n\n//select a non-exposed card\nnonExposedCards = NewList();\nforeach (card in player.placedCards){\n    if (IsCardExposed(card)) {continue;}\n    AddToList(nonExposedCards, card);\n}\nMakeCardSelectionOfList(player, nonExposedCards, 1, \"Select a card to add 2 Sacrifice to\", out cardList);\n\nif (GetListLength(cardList) == 0) {return;}\n\nselectedCard = cardList[0];\n\nselectedCard.sacrificeValue += 2;"},"inputParameters":[{"Name":{"value":"player"},"DataType":{"value":8},"DefaultValue":{},"Guid":{"part1":4608685779264083377,"part2":8420977427048039654}}],"outputParameters":[],"Position":{"value":{"X":-264.0,"Y":600.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{},"ConnectedFieldGuid":{"value":{"part1":16216884031184401489,"part2":6462606891633588241}},"customMetadata":{"Name":"player","DataType":8,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":8830912039086436190,"part2":15482446651140907571},"ParameterGuid":{"part1":4608685779264083377,"part2":8420977427048039654}}]},"OutputFields":{"customFields":[]},"thisExecutor":{"Guid":{"part1":13673383414245024683,"part2":10810021907676079382}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"Guid":{"part1":14726094064642862804,"part2":15035765726927734864}},"Version":1,"Guid":{"part1":3997981537961064914,"part2":14450764914285317038}}
