ScriptNode {"Script":{"value":"input Card playedCard;\n\nowner = playedCard.owner;\n\nif (owner != thisCard.owner) {return;}\n\ndist = Distance(playedCard, owner.leader);\n\nif (dist <= 2) {return;}\n\nAddPlacementWorship(playedCard, 1);"},"inputParameters":[{"Name":{"value":"playedCard"},"DataType":{"value":6},"DefaultValue":{},"Guid":{"part1":13076177665422079529,"part2":17552721331644768643}}],"outputParameters":[],"Position":{"value":{"X":96.0,"Y":312.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{},"ConnectedFieldGuid":{"value":{"part1":13342519688671650627,"part2":14785623838292630332}},"customMetadata":{"Name":"playedCard","DataType":6,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":17781335283453395008,"part2":13272165843111064185},"ParameterGuid":{"part1":13076177665422079529,"part2":17552721331644768643}}]},"OutputFields":{"customFields":[]},"thisExecutor":{"Guid":{"part1":6870275027256507607,"part2":16754265681714198100}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"Guid":{"part1":5276590836260222767,"part2":16544984344350984391}},"Version":1,"Guid":{"part1":849547972526873593,"part2":12607221204877538794}}
