ScriptNode {"Script":{"value":"input Player player;\n\ndistantCards = NewList();\nforeach (card in player.placedCards){\n    distance = Distance(card, player.leader);\n    if (distance <= 2) {continue;}\n    AddToList(distantCards, card);\n}\nif (GetListLength(distantCards) == 0) {return;}\nMakeCardSelectionOfList(player, distantCards, _, out cardList);\n\nforeach(selectedCard in cardList){\n    DispatchTriggerAbility(selectedCard, player);\n}"},"inputParameters":[{"Name":{"value":"player"},"DataType":{"value":8},"DefaultValue":{},"Guid":{"part1":7223742547648966385,"part2":10878125545421245975}}],"outputParameters":[],"Position":{"value":{"X":48.0,"Y":672.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{},"ConnectedFieldGuid":{"value":{"part1":4989689374897335009,"part2":11604734093131364954}},"customMetadata":{"Name":"player","DataType":8,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":15226504321882723848,"part2":5674036355863307574},"ParameterGuid":{"part1":7223742547648966385,"part2":10878125545421245975}}]},"OutputFields":{"customFields":[]},"thisExecutor":{"Guid":{"part1":16051195253519094913,"part2":11597501452252084551}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"Guid":{"part1":8710431044999168194,"part2":17379362305441901207}},"Version":1,"Guid":{"part1":10675309787788374284,"part2":17976043902380085522}}
