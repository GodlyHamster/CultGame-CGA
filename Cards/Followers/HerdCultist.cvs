ScriptNode {"Script":{"value":"// Here would go being commanded due to Groupthink\n// This should be a different event so they don't retrigger it\n\n// Being commanded by groupthink counts as your \"one-command-per-turn\" unless your deity is Endless Whisper\nif (!GetListContainsItem(thisCard))\n{\n    AddToList(player.commandedCards, thisCard);\n}"},"inputParameters":[],"outputParameters":[],"Position":{"value":{"X":48.0,"Y":504.0}},"Comment":{"value":""},"InputFields":{"customFields":[]},"OutputFields":{"customFields":[]},"thisExecutor":{"Guid":{"part1":2509944511377937837,"part2":8139909725750433693}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"Guid":{"part1":10679411858165063695,"part2":4794136958520764308}},"Version":1,"Guid":{"part1":17562694499300048451,"part2":18249585591249885389}}
