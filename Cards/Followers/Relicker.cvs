ScriptNode {"Script":{"value":"input bool isExposed;\n\nforeach (card in thisCard.buffedCards){\n    if (isExposed){\n        AddPlacementWorship(card, -1);\n        AddPlacementPower(card, -1);\n        continue;\n    }\n    AddPlacementWorship(card, 1);\n    AddPlacementPower(card, 1);\n}"},"inputParameters":[{"Name":{"value":"isExposed"},"DataType":{"value":4},"DefaultValue":{"BooleanFieldValue":{"value":false}},"Guid":{"part1":16187542444847204749,"part2":7595384098915464445}}],"outputParameters":[],"Position":{"value":{"X":-72.0,"Y":744.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"BooleanFieldValue":{"value":false}},"ConnectedFieldGuid":{"value":{"part1":7999204825142684570,"part2":6621835358984770780}},"customMetadata":{"Name":"isExposed","DataType":4,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":15368525344039343061,"part2":17851335125686764605},"ParameterGuid":{"part1":16187542444847204749,"part2":7595384098915464445}}]},"OutputFields":{"customFields":[]},"thisExecutor":{"Guid":{"part1":9929354483438302386,"part2":5098093487257909561}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"Guid":{"part1":14100301888520933353,"part2":11176747131298035850}},"Version":1,"Guid":{"part1":1440870619489974731,"part2":7175013387232645036}}
ScriptNode {"Script":{"value":"DirectionPrompt(out dirX, out dirY);\n\nGetAllCardsInDirection(thisCard, dirX, dirY, out cardList);\n\nthisCard.dirX = dirX;\nthisCard.dirY = dirY;\n\nforeach (card in cardList){\n    AddPlacementWorship(card, 1);\n    AddPlacementPower(card, 1);\n    AddToList(thisCard.buffedCards, card);\n}"},"inputParameters":[],"outputParameters":[],"Position":{"value":{"X":-144.0,"Y":264.0}},"Comment":{"value":""},"InputFields":{"customFields":[]},"OutputFields":{"customFields":[]},"thisExecutor":{"Guid":{"part1":8817157540973423196,"part2":11571824149188372669}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"Guid":{"part1":1205939437419819109,"part2":8233811112346887038}},"Version":1,"Guid":{"part1":2368190644088703111,"part2":7581397967520372034}}
