ScriptNode {"Script":{"value":"input Card playedCard;\n\nif (thisCard.owner != playedCard.owner) {return;}\nif (thisCard.isPlaced == false) {return;}\nif (playedCard == thisCard) {return;}\n\n\nif (thisCard.dirX != 0){\n    if (thisCard.y != playedCard.y) {return;}\n    if (thisCard.dirX > 0 && playedCard.x < thisCard.x) {return;}\n    if (thisCard.dirX < 0 && playedCard.x > thisCard.x) {return;}\n}\n\nif (thisCard.dirY != 0){\n    if (thisCard.x != playedCard.x) {return;}\n    if (thisCard.dirY > 0 && playedCard.y < thisCard.y) {return;}\n    if (thisCard.dirY < 0 && playedCard.y > thisCard.y) {return;}\n}\n\nif (!IsCardExposed(thisCard)){\n    AddPlacementWorship(playedCard, 1);\n    AddPlacementPower(playedCard, 1);\n}\nAddToList(thisCard.buffedCards, playedCard);"},"inputParameters":[{"Name":{"value":"playedCard"},"DataType":{"value":6},"DefaultValue":{},"Guid":{"part1":5132250431067473574,"part2":11052774931750998892}}],"outputParameters":[],"Position":{"value":{"X":480.0,"Y":792.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{},"ConnectedFieldGuid":{"value":{"part1":3428928444384942782,"part2":13305973642130483392}},"customMetadata":{"Name":"playedCard","DataType":6,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":17618229088160640079,"part2":14578382070290988942},"ParameterGuid":{"part1":5132250431067473574,"part2":11052774931750998892}}]},"OutputFields":{"customFields":[]},"thisExecutor":{"Guid":{"part1":14845676658628100775,"part2":7296896135723091643}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"Guid":{"part1":2651193852132258430,"part2":16463137936165151061}},"Version":1,"Guid":{"part1":5139941645897582685,"part2":6616434127521440253}}
