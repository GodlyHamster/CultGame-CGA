ScriptNode {"Script":{"value":"foreach (card in GetAdjecentCards(thisCard)){\n    if (CardHasTag(card, \"Deity\")) { continue; }\n    AddPlacementPower(thisCard, -1);\n    if (HasSameCardLogic(thisCard, card)) {return;}\n    AddToList(thisCard.protectedCards, card);\n    card.isInvincible = true;\n}"},"inputParameters":[],"outputParameters":[],"Position":{"value":{"X":-48.0,"Y":240.0}},"Comment":{"value":""},"InputFields":{"customFields":[]},"OutputFields":{"customFields":[]},"thisExecutor":{"Guid":{"part1":15147833325235564834,"part2":8251273058193798421}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":5869791980752886359,"part2":8607523544304817358}},"Guid":{"part1":2025271456568360875,"part2":17133038627950776104}},"Version":1,"Guid":{"part1":17262261359085552967,"part2":4491495317227721602}}
