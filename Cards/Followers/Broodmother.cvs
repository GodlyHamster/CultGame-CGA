ScriptNode {"Script":{"value":"input Card playedCard;\n\nif (!thisCard.isPlaced) { return; }\nif (playedCard.owner != thisCard.owner) { return; }\n\nadjcentCards = GetAdjecentCards(playedCard);\nif (!GetListContainsItem(adjcentCards, thisCard)) { return; }\n\nAddPlacementPower(thisCard, -1);\n\nif (HasSameCardLogic(thisCard, playedCard)) {return;}\n\nAddToList(thisCard.protectedCards, playedCard);\n\nplayedCard.isInvincible = true;"},"inputParameters":[{"Name":{"value":"playedCard"},"DataType":{"value":6},"DefaultValue":{},"Guid":{"part1":10193679627529563584,"part2":17970660782742516386}}],"outputParameters":[],"Position":{"value":{"X":-48.0,"Y":456.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{},"ConnectedFieldGuid":{"value":{"part1":663083533958967888,"part2":6278679097868343394}},"customMetadata":{"Name":"playedCard","DataType":6,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":8497710776246321261,"part2":14479406368383727391},"ParameterGuid":{"part1":10193679627529563584,"part2":17970660782742516386}}]},"OutputFields":{"customFields":[]},"thisExecutor":{"Guid":{"part1":11193784710219043834,"part2":5431670656196628754}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":5869791980752886359,"part2":8607523544304817358}},"Guid":{"part1":17374167764567510081,"part2":17358437494194953114}},"Version":1,"Guid":{"part1":13251010798310236523,"part2":16652244010337514900}}
