ScriptNode {"Script":{"value":"input InputParameter player;\ninput InputParameter cardLogic;\ninput InputParameter cardLayout;\ninput InputParameter x;\ninput InputParameter y;\ninput OutputParameter cardOutput;\n\ncontainer = FindContainer(player, \"x\"+x+\"y\"+y);\n\nif (container == null){\n    LogWarning(\"Couldnt place card at x\"+x+\", y\"+y+\". Container doesnt exist\");\n    return;\n}\n\nCreateCard(cardLogic, cardLayout, container, -1, out card);\ncard.x = x;\ncard.y = y;\n\nAddToList(player.placedCards, card);\n\n//we can assume it is connected because\n//cards can only be placed adjecent to other cards\ncard.connectedToLeader = true;\n\nSetParameter(cardOutput, card);"},"inputParameters":[{"Name":{"value":"player"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":3001311684506182861,"part2":8206568467936621082}},{"Name":{"value":"cardLogic"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":3701156373187920504,"part2":16888912832446850259}},{"Name":{"value":"cardLayout"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":7879103695186225254,"part2":5259648409308269658}},{"Name":{"value":"x"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":12488642831719493971,"part2":1010839407738668027}},{"Name":{"value":"y"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":17819800471610718386,"part2":2964290804769571997}},{"Name":{"value":"cardOutput"},"DataType":{"value":13},"DefaultValue":{"NodeOutputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":18141082560044100303,"part2":16112995635710039755}}],"outputParameters":[],"Position":{"value":{"X":-264.0,"Y":-72.0}},"Comment":{"value":""},"InputFields":{"customFi