ScriptNode {"Script":{"value":"input InputParameter x;\ninput InputParameter y;\ninput OutputParameter cardOutput;\n\nc = FindContainer(_, \"x\"+x+\"y\"+y);\n\nif (c == null){\n    LogWarning(\"Couldnt place card at x\"+x+\", y\"+y+\". Container doesnt exist\");\n    return;\n}\n\nCreateCard(_, _, c, -1, out card);\ncard.x = x;\ncard.y = y;\n\nAddToList(game.placedCards, card);\n\n//we can assume it is connected because\n//cards can only be placed adjecent to other cards\ncard.connectedToLeader = true;\n\nSetParameter(cardOutput, card);"},"inputParameters":[{"Name":{"value":"x"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":12488642831719493971,"part2":1010839407738668027}},{"Name":{"value":"y"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":17819800471610718386,"part2":2964290804769571997}},{"Name":{"value":"cardOutput"},"DataType":{"value":13},"DefaultValue":{"NodeOutputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":18141082560044100303,"part2":16112995635710039755}}],"outputParameters":[],"Position":{"value":{"X":-264.0,"Y":-72.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":5112510823745529914,"part2":15473765458707010281}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"x","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":17705387372604101929,"part2":17731429570419990726},"ParameterGuid":{"part1":12488642831719493971,"part2":1010839407738668027}},{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":3737110960964808833,"part2":8795904445379501569}}},"ConnectedFieldGuid":{"valu