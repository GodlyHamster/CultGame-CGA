{"InputParameters":{"value":[{"Name":{"value":"fromCard"},"DataType":{"value":6},"DefaultValue":{},"Guid":{"part1":2618362093571454432,"part2":12924158726626313984}},{"Name":{"value":"directionX"},"DataType":{"value":1},"DefaultValue":{"IntFieldValue":{"value":0},"StringFieldValue":{"value":""}},"Guid":{"part1":10188945038499955118,"part2":9259475142079069146}},{"Name":{"value":"directionY"},"DataType":{"value":1},"DefaultValue":{"IntFieldValue":{"value":0}},"Guid":{"part1":11358682931308258410,"part2":11582276693551603807}}]},"OutputParameters":{"value":[{"Name":{"value":"cardList"},"DataType":{"value":7},"DefaultValue":{},"Guid":{"part1":17153245901408396939,"part2":11927428811940458139}}]}}
ScriptNode {"Script":{"value":"input InputParameter fromCard;\ninput InputParameter dirX;\ninput InputParameter dirY;\ninput OutputParameter outCardList;\n\nif (dirX != 0 && dirY != 0){\n    LogWarning(\"Cannot get cards in 2 directions at once\");\n    return;\n}\n\nowner = fromCard.owner;\n\ncardList = NewList();\n\nrepeatX = Abs(dirX * fromCard.x);\nif (dirX > 0){\n    repeatX = Abs(fromCard.x - (game.gridX - 1));\n}\nrepeatY = Abs(dirY * fromCard.y);\nif (dirY > 0){\n    repeatY = Abs(fromCard.y - (game.gridY - 1));\n}\n\nrepeat(repeatX, out i){\n    i = (i*dirX)+dirX + fromCard.x;\n    card = GetCardAtPosition(owner, i, fromCard.y);\n    if (card == null || CardHasTag(card, \"T_Deity\")){\n        continue;\n    }\n    AddToList(cardList, card);\n}\n\nrepeat(repeatY, out i){\n    i = (i*dirY)+dirY + fromCard.y;\n    card = GetCardAtPosition(owner, fromCard.x, i);\n    if (card == null || CardHasTag(card, \"T_Deity\")){\n        continue;\n    }\n    AddToList(cardList, card);\n}\n\nSetParameter(outCardList, cardList);"},"inputParameters":[{"Name":{"value":"fromCard"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":1541252575951759553,"part2":16126988791240004937}},{"Name":{"value":"dirX"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":7100643959283700595,"part2":4074207694691130393}},{"Name":{"value":"dirY"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":14016097818682261254,"part2":9330516501328185007}},{"Name":{"value":"outCardList"},"DataType":{"value":13},"DefaultValue":{"NodeOutputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":213848542727265471,"part2":6863151983931750154}}],"outputParameters":[],"Position":{"value":{"X":-120.0,"Y":0.0}},"Comment":{"value":"returns all card in a certain direction until an empty slot is found"},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":2618362093571454432,"part2":12924158726626313984}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"fromCard","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":17622390219927271638,"part2":16315547557564575680},"ParameterGuid":{"part1":1541252575951759553,"part2":16126988791240004937}},{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":10188945038499955118,"part2":9259475142079069146}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"dirX","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":8017237516122286999,"part2":15089851291621027101},"ParameterGuid":{"part1":7100643959283700595,"part2":4074207694691130393}},{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":11358682931308258410,"part2":11582276693551603807}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"dirY","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":4498697163754921114,"part2":17977327516691822722},"ParameterGuid":{"part1":14016097818682261254,"part2":9330516501328185007}},{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeOutputParameterRefValue":{"value":{"part1":17153245901408396939,"part2":11927428811940458139}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"outCardList","DataType":13,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":8762709362154540339,"part2":