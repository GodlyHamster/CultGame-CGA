ScriptNode {"Script":{"value":"input InputParameter player;\ninput InputParameter attacker;\n\nSelectAttackTarget(player, attacker, out target);\n\nif (target == null) { return; }\nif (!CanBeAttacked(target)) { return; }\n\ntargetWillDie = GetAttackResult(attacker, target);\n\nif (CardHasTag(player.selectedAttacker, \"T_AttackAbility\")){\n    DispatchAttackAbility(player.selectedAttacker, target, targetWillDie);\n}\n\n//if disconnected from leader they die from any attack\nif (targetWillDie){\n    KillCard(target);\n}"},"inputParameters":[{"Name":{"value":"player"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":1384169542183866970,"part2":16894338155759518864}},{"Name":{"value":"attacker"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":14774373423973325384,"part2":12744094978914041551}}],"outputParameters":[],"Position":{"value":{"X":144.0,"Y":144.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":15639415451047935448,"part2":5385340863218036170}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"player","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":18166312668776486484,"part2":12507615188399277440},"ParameterGuid":{"part1":1384169542183866970,"part2":16894338155759518864}},{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":763637303997748447,"part2":6595747731700615257}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"attacker","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":15714207551064891210,"part2":33307