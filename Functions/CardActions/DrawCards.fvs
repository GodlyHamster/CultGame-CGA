ScriptNode {"Script":{"value":"input InputParameter player;\ninput InputParameter amount;\n\ndeck = FindContainer(player, \"deck\");\ndeckCards = GetContainerCards(deck);\nhand = FindContainer(player, \"hand\");\n\namount = Min(amount, GetListLength(deckCards));\n\nrepeat(amount, out i){\n    index = amount - (i+1);\n    card = deckCards[index];\n    MoveCard(card, hand, -1, 0.2, true);\n}"},"inputParameters":[{"Name":{"value":"player"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":13890337936972476569,"part2":17965739185874957498}},{"Name":{"value":"amount"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":17137177985078376139,"part2":5412063872305470751}}],"outputParameters":[],"Position":{"value":{"X":48.0,"Y":0.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":13361910712720944848,"part2":5466406839685801749}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"player","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":12955833975414888239,"part2":9588103427469544983},"ParameterGuid":{"part1":13890337936972476569,"part2":17965739185874957498}},{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":749759752532784453,"part2":6337548659232998854}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"amount","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":14384994070059069549,"part2":4787089699143591086},"ParameterGuid":{"part1":17137177985078376139,"part2":5412063872305470751}}]},"OutputFields":{"customFields":[]},"thisExecu