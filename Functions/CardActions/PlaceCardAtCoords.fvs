ScriptNode {"Script":{"value":"input InputParameter card;\ninput InputParameter x;\ninput InputParameter y;\n\nowner = card.owner;\n\nc = FindContainer(owner, \"x\"+x+\"y\"+y);\n\nif (c == null){\n    LogWarning(\"Couldnt place card at x\"+x+\", y\"+y+\". Container doesnt exist\");\n    return;\n}\n\nMoveCard(card, c, -1, 0.3, false);\ncard.x = x;\ncard.y = y;\n\nAddToList(owner.placedCards, card);\n\n//we can assume it is connected because\n//cards can only be placed adjecent to other cards\ncard.connectedToLeader = true;\n\n//check for any adjecent cards that werent connected\nTryReconnectCards(owner);"},"inputParameters":[{"Name":{"value":"card"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":16072572547275991090,"part2":9210849957247338715}},{"Name":{"value":"x"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":12488642831719493971,"part2":1010839407738668027}},{"Name":{"value":"y"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":17819800471610718386,"part2":2964290804769571997}}],"outputParameters":[],"Position":{"value":{"X":-240.0,"Y":0.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":3082057081216897487,"part2":7106375428811488284}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"card","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":17031264398816110425,"part2":16638634120334482130},"ParameterGuid":{"part1":16072572547275991090,"part2":9210849957247338715}},{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":18068517694533008