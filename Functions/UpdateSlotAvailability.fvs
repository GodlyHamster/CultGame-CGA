{"InputParameters":{"value":[{"Name":{"value":"card"},"DataType":{"value":6},"DefaultValue":{},"Guid":{"part1":5072017070456087481,"part2":3031707700718940556}},{"Name":{"value":"gotPlaced"},"DataType":{"value":4},"DefaultValue":{"BooleanFieldValue":{"value":false}},"Guid":{"part1":8378058876049912455,"part2":12022190351795481269}}]},"OutputParameters":{"value":[]}}
ScriptNode {"Script":{"value":"input InputParameter card;\ninput InputParameter gotPlaced;\n\nowner = card.owner;\n\ncurrentSlot = GetSlotAtPosition(owner, card.x, card.y);\nforeach(adjSlot in GetAdjecentSlots(card)){\n    if (gotPlaced){\n        RemoveFromList(owner.availableSlots, currentSlot);\n        adjSlot.adjecentCards += 1;\n    }\n    else{\n        adjSlot.adjecentCards -= 1;\n    }    \n    \n    if (adjSlot.adjecentCards == 0){\n        if (!IsCardExposed(card)){\n            AddToList(owner.availableSlots, currentSlot);\n        }\n        RemoveFromList(owner.availableSlots, adjSlot);\n        continue;\n    }\n    \n    if (SlotContainsCard(owner, adjSlot.x, adjSlot.y)) {continue;}\n    if (GetListContainsItem(owner.availableSlots, adjSlot)) {continue;}\n    AddToList(owner.availableSlots, adjSlot);\n}\n\nif (gotPlaced) {return;}\n\nif (currentSlot.adjecentCards > 0){\n    AddToList(owner.availableSlots, currentSlot);\n}"},"inputParameters":[{"Name":{"value":"card"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":3994400021695249173,"part2":7583645448650056619}},{"Name":{"value":"gotPlaced"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":8978922799329702787,"part2":9446747810244683950}}],"outputParameters":[],"Position":{"value":{"X":-120.0,"Y":0.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":5072017070456087481,"part2":3031707700718940556}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"card","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":7156218043681835463,"part2":2759930741412643524},"ParameterGuid":{"part1":3994400021695249173,"part2":7583645448650056619}},{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":8378058876049912455,"part2":12022190351795481269}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"gotPlaced","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":226382008438128220,"part2":13662477820691198444},"ParameterGuid":{"part1":8978922799329702787,"part2":9446747810244683950}}]},"OutputFields":{"customFields":[]},"thisExecutor":{"Guid":{"part1":612593925807642042,"part2":2069750657849809865}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"Guid":{"part1":13414878569666842257,"part2":8085675691267325482}},"Version":1,"Guid":{"part1":6818403332275804679,"part2":8301626091393266674}}
