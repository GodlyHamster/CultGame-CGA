ScriptNode {"Script":{"value":"input InputParameter player;\ninput InputParameter cardList;\ninput OutputParameter cardSelection;\n\nselectedCards = NewList();\nselectionCompleted = false;\n\nwhile (selectionCompleted == false){\n    foreach (card in cardList){\n        if (card == thisCard) {continue;}\n\n        AddCardClickInput(\"selectCard\", player, card);\n    }\n    AddEndActionInput(player, \"End selection\");\n    \n    WaitForInput();\n    \n    if (GetInputId() == \"selectCard\"){\n        clickedCard = GetClickedCard();\n        if (GetListContainsItem(selectedCards, clickedCard)){\n            Log(\"Unselected: \"+clickedCard);\n            RemoveFromList(selectedCards, clickedCard);\n        }\n        else{\n            Log(\"Selected: \"+clickedCard);\n            AddToList(selectedCards, clickedCard);\n        }\n    }\n    if (GetInputId() == \"endAction\"){\n        selectionCompleted = true;\n        break;\n    }\n}\n\nSetParameter(cardSelection, selectedCards);"},"inputParameters":[{"Name":{"value":"player"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":16796242406162299474,"part2":16525675524411957961}},{"Name":{"value":"cardList"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":28875728160705979,"part2":3092959002159339656}},{"Name":{"value":"cardSelection"},"DataType":{"value":13},"DefaultValue":{"NodeOutputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":5569714898273435196,"part2":14453864778463683368}}],"outputParameters":[],"Position":{"value":{"X":120.0,"Y":0.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":10765947899429081365,"part2":8704170414284568494}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"