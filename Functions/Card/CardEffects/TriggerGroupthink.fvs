{"InputParameters":{"value":[{"Name":{"value":"owner"},"DataType":{"value":8},"DefaultValue":{},"Guid":{"part1":17381114054407450722,"part2":3065749925529393005}},{"Name":{"value":"card"},"DataType":{"value":6},"DefaultValue":{},"Guid":{"part1":7334305068113068465,"part2":3333116964021121150}}]},"OutputParameters":{"value":[]}}
ScriptNode {"Script":{"value":"input InputParameter owner;\ninput InputParameter card;\n\nClearCardSelection(owner);\n\nif(GetListContainsItem(owner.commandedCards, card)) {return;} //prevent looping groupthink\nAddToList(owner.commandedCards, card);\n\nowner.selectedAttacker = card;\n\ngroupThinkList = GetConnectedGroupByTag(owner.selectedAttacker, \"T_GroupThink\");\nRemoveFromList(groupThinkList, owner.selectedAttacker);\n\nif (GetListLength(groupThinkList) == 0) {return;}\n\n//try selecting a card that can attack if the current cant\nif (!owner.selectedAttacker.canAttack){\n    repeat(GetListLength(groupThinkList), out i){\n        if (!groupThinkList[i].canAttack) {continue;}\n        owner.selectedAttacker = groupThinkList[i];\n        AddPowerIncrease(owner.selectedAttacker, card.power);\n        break;\n    }\n}\n\n//trigger all groupthink data\nforeach(c in groupThinkList){\n    AddPlayerWorship(owner, TotalCardWorship(c));\n    AddToList(owner.commandedCards, c);\n    if (c == owner.selectedAttacker) {continue;}\n    AddPowerIncrease(owner.selectedAttacker, TotalCardPower(c));\n}\n//trigger abilities of selected cards\nforeach(c in groupThinkList){\n    DispatchCE_TriggerAbility(c, owner);\n}"},"inputParameters":[{"Name":{"value":"owner"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":12593963956697177229,"part2":2462394053084254199}},{"Name":{"value":"card"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":14389375394573750097,"part2":5654808828297234106}}],"outputParameters":[],"Position":{"value":{"X":-216.0,"Y":-48.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":17381114054407450722,"part2":3065749925529393005}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"owner","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":6934112861010051009,"part2":10019984072882986039},"ParameterGuid":{"part1":12593963956697177229,"part2":2462394053084254199}},{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":7334305068113068465,"part2":3333116964021121150}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"card","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":15320652931913198204,"part2":12574372461553806986},"ParameterGuid":{"part1":14389375394573750097,"part2":5654808828297234106}}]},"OutputFields":{"customFields":[]},"thisExecutor":{"Guid":{"part1":17742972420018633462,"part2":15234508994225394489}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"Guid":{"part1":14977804290027912914,"part2":854514855658621708}},"Version":1,"Guid":{"part1":13590976860097883570,"part2":3654708816491363034}}
