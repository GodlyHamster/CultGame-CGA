ScriptNode {"Script":{"value":"input InputParameter player;\ninput InputParameter card;\n\ncardIsDeity = CardHasTag(card, \"T_Deity\");\n\n//card command order:\n//ability -> worship -> attack\nplayer.selectedAttacker = card;\nRemoveOrdersLeft(player, card.commandCost);\n\n//trigger ability\nDispatchCE_TriggerAbility(card, player);\n\nif (!cardIsDeity){\n    //add worship\n    AddPlayerWorship(player, TotalCardWorship(card));\n\n    //do attack\n    if (CanCardAttack(player.selectedAttacker)){\n        HandleCardAttack(player, player.selectedAttacker);\n    }\n}\n\nDispatchCE_CommandEnd(card);\n\n//update commanded cards list\nAddToList(player.commandedCards, card);\n\nClearCardSelection(player);"},"inputParameters":[{"Name":{"value":"player"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":11321413106368208725,"part2":15848117222076469888}},{"Name":{"value":"card"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":5122428199396242278,"part2":12467884094861264888}}],"outputParameters":[],"Position":{"value":{"X":-96.0,"Y":0.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":11291980193440306863,"part2":6498138207593555902}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"player","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":2234463970276807266,"part2":7810291749029530027},"ParameterGuid":{"part1":11321413106368208725,"part2":15848117222076469888}},{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":15886215854718856454,"part2":5175171125104703605}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"card","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":2579938121297212407,"part2":15114552813620690436},"ParameterGuid":{"part1":5122428199396242278,"part2":12467884094861264888}}]},"OutputFields":{"customFields":[]},"thisExecutor":{"Guid":{"part1":10685273820208657859,"part2":5298665334277318961}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"Guid":{"part1":2470849214908848216,"part2":860132082889113798}},"Version":1,"Guid":{"part1":2186857916065215618,"part2":11915954938419604901}}
