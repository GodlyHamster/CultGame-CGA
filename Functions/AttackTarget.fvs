ScriptNode {"Script":{"value":"input InputParameter attacker;\ninput InputParameter target;\n\nif (CardHasTag(target, \"Deity\")) {return;}\n\nif (target.holyShield){\n    EnableHolyShield(target, false);\n    return;\n}\n\n//if disconnected from leader they die from any attack\nif (TotalCardPower(attacker) >= TotalCardPower(target) || IsCardExposed(target)){\n    DispatchCharacterDies(target);\n    DispatchCardDies(target);\n    RemoveCard(target);\n    DispatchCardKillsTarget(attacker, target);\n}"},"inputParameters":[{"Name":{"value":"attacker"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":18094865997916626568,"part2":10881817835718047595}},{"Name":{"value":"target"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":16185839284136407327,"part2":17396063226279602843}}],"outputParameters":[],"Position":{"value":{"X":-120.0,"Y":0.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":6806707504213221730,"part2":4710681190964872081}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"attacker","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":13294542134856169568,"part2":8999664334450845445},"ParameterGuid":{"part1":18094865997916626568,"part2":10881817835718047595}},{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":236648158034895980,"part2":17636569593991227727}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"target","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":13017196422416741428,"part2":13958726400296230877},"Pa