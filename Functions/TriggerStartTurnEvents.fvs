ScriptNode {"Script":{"value":"input InputParameter player;\n\nendActionArea = FindWidget(_, \"endActionArea\");\nSetWidgetVisibility(endActionArea, false);\n\nResetPlayerTurnVariables(player);\n\nforeach(card in player.placedCards){\n    if (card == player.leader) {continue;}\n\n    if (card.holyShield){\n        EnableHolyShield(card, false);\n    }\n\n    if (IsCardExposed(card)){\n        SetWasExposedThisTurn(card, true);\n    }\n}"},"inputParameters":[{"Name":{"value":"player"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":7005298513577061628,"part2":8376871764842420570}}],"outputParameters":[],"Position":{"value":{"X":-48.0,"Y":0.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":16661546010889771455,"part2":3520979744562780280}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"player","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":16336754759641217141,"part2":3898234355292820489},"ParameterGuid":{"part1":7005298513577061628,"part2":8376871764842420570}}]},"OutputFields":{"customFields":[]},"thisExecutor":{"Guid":{"part1":664058249113009471,"part2":13020995259108235500}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"Guid":{"part1":7805433158212555852,"part2":9866629198968875105}},"Version":1,"Guid":{"part1":7556534075519390605,"part2":13302372462106939161}}
