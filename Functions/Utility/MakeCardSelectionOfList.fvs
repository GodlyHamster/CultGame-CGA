ScriptNode {"Script":{"value":"input InputParameter player;\ninput InputParameter cardList;\ninput InputParameter selectionLimit;\ninput InputParameter selectionPrompt;\ninput OutputParameter cardSelection;\n\n//todo: create better way to allow infinite selection\nif (selectionLimit == -1){selectionLimit = 1000;}\n\nselectedCards = NewList();\nselectionCompleted = false;\n\nwhile (selectionCompleted == false){\n    foreach (card in cardList){\n        if (card == thisCard) {continue;}\n        if (!GetListContainsItem(selectedCards, card) && GetListLength(selectedCards) >= selectionLimit){\n            continue;\n        }\n\n        AddCardClickInput(\"selectCard\", player, card);\n    }\n    AddEndActionInput(player, \"End selection\", selectionPrompt);\n    \n    WaitForInput();\n    \n    if (GetInputId() == \"selectCard\"){\n        clickedCard = GetClickedCard();\n        if (GetListContainsItem(selectedCards, clickedCard)){\n            RemoveFromList(selectedCards, clickedCard);\n            SetCardOverlay(clickedCard, false, _);\n        }\n        else{\n            AddToList(selectedCards, clickedCard);\n        }\n        repeat(GetListLength(selectedCards), out i){\n            SetCardOverlay(selectedCards[i], true, i);\n        }\n    }\n    if (GetInputId() == \"endAction\"){\n        selectionCompleted = true;\n        break;\n    }\n}\n\nSetParameter(cardSelection, selectedCards);"},"inputParameters":[{"Name":{"value":"player"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":16796242406162299474,"part2":16525675524411957961}},{"Name":{"value":"cardList"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":28875728160705979,"part2":3092959002159339656}},{"Name":{"value":"selectionLimit"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":1368701459333