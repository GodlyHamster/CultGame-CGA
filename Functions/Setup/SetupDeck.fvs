ScriptNode {"Script":{"value":"input InputParameter player;\n\ndeck = FindContainer(player, \"deck\");\nleaderSpot = FindContainer(player, \"x2y2\");\n\nCreatePlayerDeck(player, \"Deity\", leaderSpot);\nCreatePlayerDeck(player, \"Followers\", deck);\n\n//setup leader/deity\nleaderCard = GetContainerCards(leaderSpot)[1];\nleaderCard.x = 2;\nleaderCard.y = 2;\n\nplayer.leader = leaderCard;\n\nAddToList(player.placedCards, leaderCard);\n\nShuffle(deck, 0, false);"},"inputParameters":[{"Name":{"value":"player"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":4288649455824097183,"part2":3671874501199412748}}],"outputParameters":[],"Position":{"value":{"X":-168.0,"Y":0.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":14961252772030022570,"part2":10664538525926346428}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"player","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":13586623489944014997,"part2":17777679422177992861},"ParameterGuid":{"part1":4288649455824097183,"part2":3671874501199412748}}]},"OutputFields":{"customFields":[]},"thisExecutor":{"Guid":{"part1":12957977198985671135,"part2":977515761963490297}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":14856646300939147060,"part2":3749740876164162193}},"Guid":{"part1":1799789199125568743,"part2":9526503754881114753}},"Version":1,"Guid":{"part1":7648338549999467429,"part2":9455414278946760139}}
ScriptNode {"Script":{"value":"foreach (card in GetContainerCards(deck)){\n    card.owner = player;\n    SetupCardVariables(card);\n}\n\nSetupCardVariables(leaderCard);\nleaderCard.owner = player;\n\nplayer.availableSlots = GetAdjecentSlots(leaderCard);\nUpdateSlotAvailability(leaderCard, true);"},"inputParameters":[],"outputParameters":[],"Position":{"value":{"X":288.0,"Y":0.0}},"Comment":{"value":"add card ownership"},"InputFields":{"customFields":[]},"OutputFields":{"customFields":[]},"thisExecutor":{"Guid":{"part1":14856646300939147060,"part2":3749740876164162193}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"Guid":{"part1":13052256006675390854,"part2":6677153132689084276}},"Version":1,"Guid":{"part1":13709897731698740160,"part2":2589035286002865726}}
