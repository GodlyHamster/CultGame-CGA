ScriptNode {"Script":{"value":"input InputParameter player;\n\nxSize = 5;\nySize = 5;\n\ngame.gridX = 5;\ngame.gridY = 5;\n\nlayout = FindAsset(\"GridCard\");\n\nrepeat(xSize, out x){\n    repeat(ySize, out y){\n        cName = \"x\"+x+\"y\"+y;\n        c = FindContainer(player, cName);\n        CreateCard(_, layout, c, -1, out card);\n        card.adjecentCards = 0;\n        card.x = x;\n        card.y = y;\n    }\n}"},"inputParameters":[{"Name":{"value":"player"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":7467828291177472872,"part2":11367270460655999240}}],"outputParameters":[],"Position":{"value":{"X":-168.0,"Y":-48.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":16140646206352591358,"part2":14079313673420767910}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"player","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":3123701781482751139,"part2":13102951894782964934},"ParameterGuid":{"part1":7467828291177472872,"part2":11367270460655999240}}]},"OutputFields":{"customFields":[]},"thisExecutor":{"Guid":{"part1":3393201762155507602,"part2":5612621582312695126}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"Guid":{"part1":5888926930790135998,"part2":2470335799889473939}},"Version":1,"Guid":{"part1":11047897844892934767,"part2":13561060953118726395}}
