ScriptNode {"Script":{"value":"foreach(player in GetPlayers()){\n    worshipLabel = FindWidget(player, \"worshipLabel\");\n    SetLabelText(worshipLabel, player.worship+\"/40\");\n\n    currentPlayer = NewList(); AddToList(currentPlayer, player);\n    DoLocal(currentPlayer, {\n        ordersLabel = FindWidget(_, \"ordersLabel\");\n        SetLabelText(ordersLabel, player.ordersLeft);\n\n        remainingCostLabel = FindWidget(_, \"remainingCostLabel\");\n        SetLabelText(remainingCostLabel, player.recruitPoints);\n    });\n}"},"inputParameters":[],"outputParameters":[],"Position":{"value":{"X":-264.0,"Y":0.0}},"Comment":{"value":""},"InputFields":{"customFields":[]},"OutputFields":{"customFields":[]},"thisExecutor":{"Guid":{"part1":2178368726255994977,"part2":7850009200815115118}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"Guid":{"part1":5042357098750079703,"part2":15754758143310024620}},"Version":1,"Guid":{"part1":4414897484300770859,"part2":2037398515910781717}}
