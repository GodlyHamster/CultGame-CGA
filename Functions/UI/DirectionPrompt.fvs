ScriptNode {"Script":{"value":"input OutputParameter dirXOut;\ninput OutputParameter dirYOut;\n\nplayer = GetActivePlayer();\n\ndirX = 0;\ndirY = 0;\n\n//show window\npromptWindow = FindWidget(_, \"directionPrompt\");\nexcLocalList = NewList(); AddToList(excLocalList, player);\nDoLocal(excLocalList, {\n    SetWidgetVisibility(promptWindow, true);\n});\n\n//add inputs\ndirLeft = FindWidget(_, \"directionPromptLeft\");\ndirRight = FindWidget(_, \"directionPromptRight\");\ndirUp = FindWidget(_, \"directionPromptUp\");\ndirDown = FindWidget(_, \"directionPromptDown\");\n\nAddButtonClickInput(\"left\", player, dirLeft);\nAddButtonClickInput(\"right\", player, dirRight);\nAddButtonClickInput(\"up\", player, dirUp);\nAddButtonClickInput(\"down\", player, dirDown);\nAddEndActionInput(thisCard.owner, \"Cancel\", \"Choose a direction to apply effect to.\");\n\nWaitForInput();\n\n//read inputs\nif (GetInputId() == \"endAction\"){continue;}\n\nif (GetInputId() == \"left\") {dirX = -1;}\nelse if (GetInputId() == \"right\") {dirX = 1;}\nelse if (GetInputId() == \"up\") {dirY = -1;} //invert Y because of how the board is setup\nelse if (GetInputId() == \"down\") {dirY = 1;}\n\n//hide window\nSetWidgetVisibility(promptWindow, false);\n\nSetParameter(dirXOut, dirX);\nSetParameter(dirYOut, dirY);"},"inputParameters":[{"Name":{"value":"dirXOut"},"DataType":{"value":13},"DefaultValue":{"NodeOutputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":7249714480076216714,"part2":10431017485361269437}},{"Name":{"value":"dirYOut"},"DataType":{"value":13},"DefaultValue":{"NodeOutputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":899623587310207370,"part2":4365901570456699475}}],"outputParameters":[],"Position":{"value":{"X":96.0,"Y":0.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeOutputParameterRefValue":{"value":{"part1":4026236524788651129,"part2":4001409879459667205}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"dirXOut","DataType":13,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":4295161554373117640,"part2":842509963647639352},"ParameterGuid":{"part1":7249714480076216714,"part2":10431017485361269437}},{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeOutputParameterRefValue":{"value":{"part1":13476146399598046949,"part2":4955255042593109998}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"dirYOut","DataType":13,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":3288277417088437820,"part2":11167095778032770057},"ParameterGuid":{"part1":899623587310207370,"part2":4365901570456699475}}]},"OutputFields":{"customFields":[]},"thisExecutor":{"Guid":{"part1":1741600112963261126,"part2":6385018375493965456}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"Guid":{"part1":13567876026184103025,"part2":1452364624018556406}},"Version":1,"Guid":{"part1":5407590564262511083,"part2":4539324329202739511}}
