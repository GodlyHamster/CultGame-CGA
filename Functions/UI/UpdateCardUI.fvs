ScriptNode {"Script":{"value":"input InputParameter card;\ninput Color green;\ninput Color red;\ninput Color defaultColor;\n\npowerLabel = FindWidget(card, \"powerLabel\");\nworshipLabel = FindWidget(card, \"worshipLabel\");\n\n//power text update\nSetLabelText(powerLabel, (card.power + card.powerIncrease));\nif (card.powerIncrease != 0){\n    if (card.powerIncrease > 0){\n        SetWidgetColor(powerLabel, green);\n    }\n    else{\n        SetWidgetColor(powerLabel, red);\n    }\n}\nelse{\n    SetWidgetColor(powerLabel, defaultColor);\n}\n\n//worship text update\nSetLabelText(worshipLabel, (card.worship + card.worshipIncrease));\nif (card.worshipIncrease != 0){\n    if (card.worshipIncrease > 0){\n        SetWidgetColor(worshipLabel, green);\n    }\n    else{\n        SetWidgetColor(worshipLabel, red);\n    }\n}\nelse{\n    SetWidgetColor(worshipLabel, defaultColor);\n}"},"inputParameters":[{"Name":{"value":"card"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":13793120428472471281,"part2":12530701176203703469}},{"Name":{"value":"green"},"DataType":{"value":17},"DefaultValue":{"ColorFieldValue":{"R":{"value":0.0},"G":{"value":0.0},"B":{"value":0.0},"A":{"value":0.0}}},"Guid":{"part1":7796281529338096102,"part2":5670123335758975916}},{"Name":{"value":"red"},"DataType":{"value":17},"DefaultValue":{"ColorFieldValue":{"R":{"value":0.0},"G":{"value":0.0},"B":{"value":0.0},"A":{"value":0.0}}},"Guid":{"part1":3415912060367656831,"part2":10031719791141167800}},{"Name":{"value":"defaultColor"},"DataType":{"value":17},"DefaultValue":{"ColorFieldValue":{"R":{"value":0.0},"G":{"value":0.0},"B":{"value":0.0},"A":{"value":0.0}}},"Guid":{"part1":13675549193033051409,"part2":7618605543455614185}}],"outputParameters":[],"Position":{"value":{"X":120.0,"Y":0.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"Nod