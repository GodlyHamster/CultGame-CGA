ScriptNode {"Script":{"value":"input InputParameter player;\ninput InputParameter card;\n\nClearCardSelection(player);\nSetCardOverlay(card, true, _);\n\n//add attack input\nforeach (p in GetPlayers()){\n    foreach (otherCard in p.placedCards){\n        if (card == otherCard) {continue;}\n        if (otherCard == p.leader) {continue;}\n        AddCardTargetCardInput(\"attack\", player, card, otherCard);\n    }\n}\n\n//skip attack\nAddEndActionInput(player, \"Skip Attack\");"},"inputParameters":[{"Name":{"value":"player"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":1954685579843406152,"part2":11147741844995999153}},{"Name":{"value":"card"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":10242673702984786053,"part2":9115431531521306928}}],"outputParameters":[],"Position":{"value":{"X":-120.0,"Y":0.0}},"Comment":{"value":"attack inputs"},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":3434405962115835534,"part2":17611547175839255159}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"player","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":3827342491096351669,"part2":4934297838290727454},"ParameterGuid":{"part1":1954685579843406152,"part2":11147741844995999153}},{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":14800645263709433913,"part2":14906430864181792540}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"card","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":3822687696346581588,"part2":17115079165449107198},"ParameterGuid":{"part1":