ScriptNode {"Script":{"value":"WaitForInput();\n\nif (GetInputId() != \"attack\") {return;}\n\ncard = GetTargetingCard();\ntarget = GetTargetedCard();\n\n//if disconnected from leader they die from any attack\nif (card.power >= target.power || !target.connectedToLeader){\n    RemoveCard(target);\n}"},"inputParameters":[],"outputParameters":[],"Position":{"value":{"X":480.0,"Y":0.0}},"Comment":{"value":"resolve attack"},"InputFields":{"customFields":[]},"OutputFields":{"customFields":[]},"thisExecutor":{"Guid":{"part1":1676711579079267091,"part2":1799927261999161228}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"Guid":{"part1":11170365560637117562,"part2":12834791338731889508}},"Version":1,"Guid":{"part1":3875482397497525840,"part2":2583171282580689045}}
