ScriptNode {"Script":{"value":"input InputParameter player;\ninput InputParameter attacker;\ninput OutputParameter target;\n\nClearCardSelection(player);\nSetCardOverlay(attacker, true, _);\n\n//add attack input\nforeach (p in GetPlayers()){\n    foreach (otherCard in p.placedCards){\n        if (attacker == otherCard) {continue;}\n        if (otherCard == p.leader) {continue;}\n        if (otherCard.isInvincible) {continue;}\n        AddCardTargetCardInput(\"attack_drag\", player, attacker, otherCard);\n        AddCardClickInput(\"attack_click\", player, otherCard);\n    }\n}\n\n//skip attack\nAddEndActionInput(player, \"Skip Attack\", \"Select a target to attack\");"},"inputParameters":[{"Name":{"value":"player"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":10404099826097497480,"part2":7641836272273951521}},{"Name":{"value":"attacker"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":13541060265504089949,"part2":6383776922137517835}},{"Name":{"value":"target"},"DataType":{"value":13},"DefaultValue":{"NodeOutputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":16929342513094127223,"part2":13840810230350200586}}],"outputParameters":[],"Position":{"value":{"X":-216.0,"Y":-120.0}},"Comment":{"value":"add inputs"},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":8510449984467673725,"part2":9120520252781770258}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"player","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":7772167295268327335,"part2":3706840350367787895},"ParameterGuid":{"part1":10404099826097497480,"part2":7641836272273951521}},{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.P