ScriptNode {"Script":{"value":"WaitForInput();\n\nif (GetInputId() == \"attack_click\"){\n    SetParameter(target, GetClickedCard());\n}\nelse if (GetInputId() == \"attack_drag\"){\n    SetParameter(target, GetTargetedCard());\n}\nelse{\n    SetParameter(target, null);\n}"},"inputParameters":[],"outputParameters":[],"Position":{"value":{"X":408.0,"Y":-120.0}},"Comment":{"value":"set selected target"},"InputFields":{"customFields":[]},"OutputFields":{"customFields":[]},"thisExecutor":{"Guid":{"part1":3590133529814516207,"part2":2060597709783588025}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"Guid":{"part1":3063001759918105024,"part2":16624624473363764655}},"Version":1,"Guid":{"part1":16468150351459225129,"part2":10149140118012186795}}
