ScriptNode {"Script":{"value":"input InputParameter card;\ninput InputParameter isExposed;\n\nif (isExposed == null) {return;}\nif (card.isExposed == isExposed) {return;}\n\ncard.isExposed = isExposed;\n\nSetExposedOverlay(card, isExposed);\nDispatchExposedStateUpdated(card, isExposed);\n\n//apply visual changes\nif (isExposed){\n    SetCardRotation(card, 90, 0.3, false);\n    UpdateSlotAvailability(card, false);\n    return;\n}\n\nSetCardRotation(card, 0, 0.3, false);\nUpdateSlotAvailability(card, true);"},"inputParameters":[{"Name":{"value":"card"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":1607327696199623435,"part2":5651712926693429518}},{"Name":{"value":"isExposed"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":317188038235289894,"part2":15338011987637680858}}],"outputParameters":[],"Position":{"value":{"X":-48.0,"Y":0.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":13264721083322942881,"part2":7543126002995884659}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"card","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":6327093336580177648,"part2":984122192997492868},"ParameterGuid":{"part1":1607327696199623435,"part2":5651712926693429518}},{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":237903295140378483,"part2":3191357528784673656}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"isExposed","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":12335220081626565310,"part2":14029597770485158622},"Paramet