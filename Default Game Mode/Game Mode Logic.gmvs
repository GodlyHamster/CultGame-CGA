ScriptNode {"Script":{"value":"SetupGrid();\n\nCreateCardAtCoords(0, 1, out cardA);\nCreateCardAtCoords(1, 1);\nCreateCardAtCoords(2, 1);\nCreateCardAtCoords(3, 1, out cardB);\nCreateCardAtCoords(4, 1);\n\nGetAllCardsInDirection(cardB, 1, 0, out list);\nadjecentCards = GetAdjecentCards(cardB);\nconnected = IsConnectedToPosition(cardB, 0, 0);\n\nLog(\"Cards in direction: \"+GetListLength(list));\nLog(\"Adjecent card count: \"+GetListLength(adjecentCards));\nLog(\"Is connected: \"+connected);\nLog(\"distance between cards: \"+Distance(cardA, cardB));\n\nWaitForInput();"},"inputParameters":[],"outputParameters":[],"Position":{"value":{"X":48.0,"Y":0.0}},"Comment":{"value":""},"InputFields":{"customFields":[]},"OutputFields":{"customFields":[]},"thisExecutor":{"Guid":{"part1":9362825041268307800,"part2":15923514414992578360}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":37175245939060480,"part2":17599613314532417934}},"Guid":{"part1":4805069070651635929,"part2":18084109668497007853}},"Version":1,"Guid":{"part1":13720916829929746251,"part2":12128588131975180885}}
