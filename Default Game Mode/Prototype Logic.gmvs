ScriptNode {"Script":{"value":"player = GetActivePlayer();\n\n//get all available slots for cards to be placed in\nadjecentSlots = NewList();\nforeach(card in player.placedCards){\n    foreach(slot in GetAdjecentSlots(card)){\n        if (GetListContainsItem(adjecentSlots, slot)) {continue;}\n        if (SlotContainsCard(slot.x, slot.y)) {continue;}\n        AddToList(adjecentSlots, slot);\n    }\n}\n\nforeach(card in GetHandCards(player)){\n    foreach(availableSlot in adjecentSlots){\n        AddCardTargetCardInput(\"play\", player, card, availableSlot);\n    }\n}\n\nphaseButton = FindWidget(_, \"endPhaseButton\");\nAddButtonClickInput(\"phaseEnd\", player, phaseButton);"},"inputParameters":[],"outputParameters":[],"Position":{"value":{"X":-360.0,"Y":384.0}},"Comment":{"value":"add inputs"},"InputFields":{"customFields":[]},"OutputFields":{"customFields":[]},"thisExecutor":{"Guid":{"part1":6340610277624848874,"part2":15960471367461795310}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":10285369686675816812,"part2":15787771428038870575}},"Guid":{"part1":8905247755167612459,"part2":9231990591026561671}},"Version":1,"Guid":{"part1":11485540472569236787,"part2":6926179024418625759}}
