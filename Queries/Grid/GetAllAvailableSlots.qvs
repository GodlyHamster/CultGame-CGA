ScriptNode {"Script":{"value":"input InputParameter player;\noutput List availableSlots;\navailableSlots = NewList();\n\nforeach(card in player.placedCards){\n    if (!card.connectedToLeader) {continue;}\n    foreach(slot in GetAdjecentSlots(card)){\n        if (GetListContainsItem(availableSlots, slot)) {continue;}\n        if (SlotContainsCard(player, slot.x, slot.y)) {continue;}\n        AddToList(availableSlots, slot);\n    }\n}"},"inputParameters":[{"Name":{"value":"player"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":3461130835366816174,"part2":497403913220195204}}],"outputParameters":[{"Name":{"value":"availableSlots"},"DataType":{"value":7},"DefaultValue":{},"Guid":{"part1":17929397121849690695,"part2":13627843659653080837}}],"Position":{"value":{"X":-96.0,"Y":0.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":9350854214145491033,"part2":7974896530168529083}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"player","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":16423872154345114949,"part2":12118472624703049967},"ParameterGuid":{"part1":3461130835366816174,"part2":497403913220195204}}]},"OutputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.OutputField, CardGameMaker.Project","customMetadata":{"Name":"availableSlots","DataType":7,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":3139365482995747627,"part2":7333516693704235204},"ParameterGuid":{"part1":17929397121849690695,"part2":13627843659653080837}}]},"thisExecutor":{"Guid":{"part1":18419621338671441019,"part2":3727109507299647738}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":872833464140975054,"part2":416264657440273357}},"Gu