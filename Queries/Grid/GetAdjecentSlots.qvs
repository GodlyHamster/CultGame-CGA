ScriptNode {"Script":{"value":"input InputParameter card;\noutput List adjecentCards;\nadjecentCards = NewList();\n\nowner = card.owner;\n\nAddToList(adjecentCards, GetSlotAtPosition(owner, card.x+1, card.y));\nAddToList(adjecentCards, GetSlotAtPosition(owner, card.x-1, card.y));\nAddToList(adjecentCards, GetSlotAtPosition(owner, card.x, card.y+1));\nAddToList(adjecentCards, GetSlotAtPosition(owner, card.x, card.y-1));\n\n//remove null items\nlistLen = GetListLength(adjecentCards);\nrepeat(listLen, out i){\n    index = listLen - i - 1;\n    if (adjecentCards[index] == null){\n        RemoveFromList(adjecentCards, adjecentCards[index]);\n    }\n}"},"inputParameters":[{"Name":{"value":"card"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":16762462813483755808,"part2":6449191148890943174}}],"outputParameters":[{"Name":{"value":"adjecentCards"},"DataType":{"value":7},"DefaultValue":{},"Guid":{"part1":3324079576950105707,"part2":17490731047759045951}}],"Position":{"value":{"X":192.0,"Y":48.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":923813128769990763,"part2":11376864072262141922}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"card","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":6780756138991730533,"part2":13525385178624134193},"ParameterGuid":{"part1":16762462813483755808,"part2":6449191148890943174}}]},"OutputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.OutputField, CardGameMaker.Project","customMetadata":{"Name":"adjecentCards","DataType":7,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":18329146080994522683,"part2":8881709929966163969},"ParameterGuid":{"part1":3324079576950105707,"part2":