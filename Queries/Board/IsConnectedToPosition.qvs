ScriptNode {"Script":{"value":"input InputParameter card;\ninput InputParameter x;\ninput InputParameter y;\noutput bool isConnected;\nisConnected = false;\n\nif (card.x == x && card.y == y) {\n    isConnected = true;\n    //set query result an return\n    return;\n}\n\npassed = NewList();\ntoCheck = NewList();\nAddToList(toCheck, card);\npathFound = false;\nwhile (pathFound == false){\n    checkLength = GetListLength(toCheck);\n    repeat(checkLength, out i){\n        index = checkLength - i - 1;\n        cardToCheck = toCheck[index];\n        //check if connection has been found\n        if (cardToCheck.x==x && cardToCheck.y==y){\n            pathFound = true;\n            isConnected = true;\n            //set query result an return\n            break;\n        }\n        foreach(ac in GetAdjecentCards(cardToCheck)){\n            if (GetListContainsItem(passed, ac)){\n                continue;\n            }\n            AddToList(toCheck, ac);\n        }\n        AddToList(passed, cardToCheck);\n        RemoveFromList(toCheck, cardToCheck);\n    }\n    //no connection has been found\n    if (GetListLength(toCheck) == 0){\n        pathFound = true;\n        isConnected = false;\n        //set query result an return\n        break;\n    }\n}"},"inputParameters":[{"Name":{"value":"card"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":9114294824041831318,"part2":14300890281127911387}},{"Name":{"value":"x"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":16816122808894661073,"part2":13045004390333224812}},{"Name":{"value":"y"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":51050452203967929,"part2":6960145351227623433}}],"outputParameters":[{"Name":{"value":"isConnected"},"DataType":{"value":4},"DefaultValue":{"BooleanFieldValue":{"value":false}},"Guid":{"par