ScriptNode {"Script":{"value":"input InputParameter startingPoint;\ninput InputParameter tag;\noutput List cardGroup;\ncardGroup = NewList();\n\npassed = NewList();\ntoCheck = NewList();\nAddRangeToList(toCheck, GetAdjecentCards(startingPoint));\n\nwhile (GetListLength(toCheck) > 0){\n    listLen = GetListLength(toCheck);\n    repeat(listLen, out i){\n        index = listLen - i - 1;\n        item = toCheck[index];\n\n        if (CardHasTag(item, tag)){\n            AddToList(cardGroup, item);\n\n            foreach (adj in GetAdjecentCards(item)){\n                if (!CardHasTag(adj, tag)) {continue;}\n                if (GetListContainsItem(passed, adj)) {continue;}\n                if (GetListContainsItem(toCheck, adj)) {continue;}\n                AddToList(toCheck, adj);\n            }\n        }\n\n        AddToList(passed, item);\n        RemoveFromList(toCheck, item);\n    }\n}"},"inputParameters":[{"Name":{"value":"startingPoint"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":7028124903272662807,"part2":8492937596454594707}},{"Name":{"value":"tag"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":11562829743990581523,"part2":11795001083675097738}}],"outputParameters":[{"Name":{"value":"cardGroup"},"DataType":{"value":7},"DefaultValue":{},"Guid":{"part1":17509413015500973675,"part2":14347893190513921673}}],"Position":{"value":{"X":-48.0,"Y":0.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":16556161387461180408,"part2":8959616823539255973}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"startingPoint","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":13524895203439957125,"part2":12206510391865060778},"ParameterGuid":{"part1":7028124903272662807,"part2":8492937596454594707}},{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":7339667165524850512,"part2":8332774386744883613}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"tag","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":11791347251744095547,"part2":4051399580383345980},"ParameterGuid":{"part1":11562829743990581523,"part2":11795001083675097738}}]},"OutputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.OutputField, CardGameMaker.Project","customMetadata":{"Name":"cardGroup","DataType":7,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":8116605776131549546,"part2":3547391134668330766},"ParameterGuid":{"part1":17509413015500973675,"part2":14347893190513921673}}]},"thisExecutor":{"Guid":{"part1":16884156926177172446,"part2":408606622111128703}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":13643336802944455643,"part2":14169750041534876162}},"Guid":{"part1":12700872742450317152,"part2":11796818368337336488}},"Version":1,"Guid":{"part1":13223964262332439007,"part2":15418866170263874943}}
