ScriptNode {"Script":{"value":"input InputParameter card;\noutput bool isConnected;\nisConnected = false;\n\nleader = card.owner.leader;\n\nif (card == leader) {\n    isConnected = true;\n    //set query result an return\n    return;\n}\n\npassed = NewList();\ntoCheck = NewList();\nAddToList(toCheck, card);\npathFound = false;\n\nwhile (pathFound == false){\n    listLen = GetListLength(toCheck);\n    repeat(listLen, out i){\n        index = listLen - i - 1;\n        cardToCheck = toCheck[index];\n\n        if (cardToCheck == leader){\n            pathFound = true;\n            isConnected = true;\n            break;\n        }\n\n        foreach(adjecentCard in GetAdjecentCards(cardToCheck)){\n            if (GetListContainsItem(passed, adjecentCard)) {continue;}\n            if (GetListContainsItem(toCheck, adjecentCard)) {continue;}\n            AddToList(toCheck, adjecentCard);\n        }\n\n        AddToList(passed, cardToCheck);\n        RemoveFromList(toCheck, cardToCheck);\n    }\n\n    if (GetListLength(toCheck) == 0){\n        pathFound = true;\n        isConnected = false;\n        break;\n    }\n}\n\nforeach(passedCard in passed){\n    SetExposedState(passedCard, !isConnected);\n}"},"inputParameters":[{"Name":{"value":"card"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":5015275122727228029,"part2":10642142094503913749}}],"outputParameters":[{"Name":{"value":"isConnected"},"DataType":{"value":4},"DefaultValue":{"BooleanFieldValue":{"value":false}},"Guid":{"part1":10331826878021434000,"part2":7895907248517330466}}],"Position":{"value":{"X":-96.0,"Y":0.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":16473918022846927658,"part2":15253858466138272558}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"card","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":12547561482402288860,"part2":5414653235921878817},"ParameterGuid":{"part1":5015275122727228029,"part2":10642142094503913749}}]},"OutputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.OutputField, CardGameMaker.Project","customMetadata":{"Name":"isConnected","DataType":4,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":4300288456689777348,"part2":8250060089144783658},"ParameterGuid":{"part1":10331826878021434000,"part2":7895907248517330466}}]},"thisExecutor":{"Guid":{"part1":13241565622039217563,"part2":15977308374870973637}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":15452722685770064676,"part2":6720566336348420692}},"Guid":{"part1":7185371509652653976,"part2":11764490816007766927}},"Version":0,"Guid":{"part1":12869084809074010273,"part2":13045194900579220109}}
