ScriptNode {"Script":{"value":"input InputParameter tagName;\noutput List cardList;\ncardList = NewList();\n\ntag = FindAsset(tagName);\n\nif (tag == null){\n    LogWarning(\"No tag with name '\"+tagName+\"' was found.\");\n    return;\n}\n\nlogicsOfTag = GetTagAssets(tag);\nforeach (card in GetActivePlayer().placedCards){\n    logic = GetCardLogic(card);\n\n    if (!GetListContainsItem(logicsOfTag, logic)) {continue;}\n\n    AddToList(cardList, card);\n}"},"inputParameters":[{"Name":{"value":"tagName"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":311909994017375475,"part2":2711768159680007105}}],"outputParameters":[{"Name":{"value":"cardList"},"DataType":{"value":7},"DefaultValue":{},"Guid":{"part1":12966681688526118298,"part2":3597580706613460316}}],"Position":{"value":{"X":-24.0,"Y":0.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":13646906567942338076,"part2":5763216229680163502}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"tagName","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":11077881332342004323,"part2":4567089507276215356},"ParameterGuid":{"part1":311909994017375475,"part2":2711768159680007105}}]},"OutputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.OutputField, CardGameMaker.Project","customMetadata":{"Name":"cardList","DataType":7,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":888115011186934135,"part2":5690589717154899209},"ParameterGuid":{"part1":12966681688526118298,"part2":3597580706613460316}}]},"thisExecutor":{"Guid":{"part1":1187104816434894784,"part2":14983404375934069595}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":12883117787203608166,"part2":106534567469