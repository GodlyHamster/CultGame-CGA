ScriptNode {"Script":{"value":"input InputParameter card;\noutput bool canBeCommanded;\ncanBeCommanded = true;\n\nowner = card.owner;\n\nif (IsCardExposed(card) || WasCardExposedThisTurn(card)){\n    canBeCommanded = false;\n    //SetQueryResult(false);\n    //return;\n}\n\nif (HasCardBeenCommanded(card)) {\n    if (CardHasTag(card, \"Devout\")){\n        canBeCommanded = true;\n        //SetQueryResult(true);\n        //return;\n    }\n    else{\n        canBeCommanded = false;\n        //SetQueryResult(false);\n        //return;\n    }\n}\n\n\nif (card != owner.leader && card.placedThisTurn){\n    if (CardHasTag(card, \"QuickInitiate\")){\n        canBeCommanded = true;\n        //SetQueryResult(true);\n        //return;\n    }\n    else{\n        canBeCommanded = false;\n        //SetQueryResult(false);\n        //return;\n    }\n}\n\nif (CardHasTag(card, \"CannotCommand\")){\n    canBeCommanded = false;\n}"},"inputParameters":[{"Name":{"value":"card"},"DataType":{"value":12},"DefaultValue":{"NodeInputParameterRefValue":{"value":{"part1":0,"part2":0}}},"Guid":{"part1":13938331784360103958,"part2":5986066793193181387}}],"outputParameters":[{"Name":{"value":"canBeCommanded"},"DataType":{"value":4},"DefaultValue":{"BooleanFieldValue":{"value":false}},"Guid":{"part1":13378523746594774138,"part2":13412989302370917940}}],"Position":{"value":{"X":-72.0,"Y":24.0}},"Comment":{"value":""},"InputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.InputField, CardGameMaker.Project","bindableTypedField":{"NodeInputParameterRefValue":{"value":{"part1":503500221902135092,"part2":15448249487956680785}}},"ConnectedFieldGuid":{"value":{"part1":0,"part2":0}},"customMetadata":{"Name":"card","DataType":12,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":16022696168368502119,"part2":8748756094040278560},"ParameterGuid":{"part1":13938331784360103958,"part2":5986066793193181387}}]},"OutputFields":{"customFields":[{"$type":"CardGameMaker.Project.Logic.OutputField, CardGameMaker.Project","customMetadata":{"Name":"canBeCommanded","DataType":4,"NameVisibility":0,"PortVisibility":0,"FieldIndexMode":0,"IsRemovable":false},"Guid":{"part1":14289058546748835206,"part2":15813205408308236150},"ParameterGuid":{"part1":13378523746594774138,"part2":13412989302370917940}}]},"thisExecutor":{"Guid":{"part1":10451444151599851303,"part2":4540540062486911418}},"nextExecutor":{"ConnectedFieldGuid":{"value":{"part1":17957506501561914880,"part2":3000963235251658765}},"Guid":{"part1":6537693825097047706,"part2":2546359453395472651}},"Version":1,"Guid":{"part1":16825692253147727376,"part2":10448261980361457014}}
